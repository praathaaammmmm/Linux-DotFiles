{
  "layer": "top",
  "position": "top",

  "spacing": 6,

  "modules-left": [
    "custom/logo",
    "hyprland/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "cpu",
    "memory",
    "network",
    "bluetooth",
    "pulseaudio",
    "tray"
  ],

  "custom/logo": {
    "format": "",
    "tooltip": false,
    "on-click": "wofi --show drun"
  },

  "clock": {
    "format": "󰥔 {:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "cpu": {
    "format": " {usage}%"
  },

  "memory": {
    "format": "󰍛 {}%"
  },

  "network": {
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid}\n{signalStrength}%"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "tooltip-format": "{device_alias}",
    "on-click": "/home/pratham/.config/waybar/scripts/bluetooth-menu.sh",
    "interval": 5
  },

  "pulseaudio": {
    "format": "󰕾 {volume}%"
  },

  "tray": {
    "spacing": 10
  }
}
